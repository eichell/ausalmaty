# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Amadeus API (get from developers.amadeus.com - free tier available)
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# OpenWeatherMap API (get from openweathermap.org - free tier available)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Allowed Telegram user IDs (comma-separated, leave empty to allow all)
ALLOWED_USER_IDS=

# Bot timezone (default: Asia/Almaty)
BOT_TIMEZONE=Asia/Almaty
