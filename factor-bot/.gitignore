# Корневой .gitignore репозитория игнорирует любой каталог data/.
# Пакет src/factorbot/data — это код, а не данные; возвращаем его.
!src/factorbot/data/

# Сырьё и собранные базы: гигабайты, воспроизводятся из build.py
data/raw/
data/processed/
*.duckdb
*.duckdb.wal

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

.ipynb_checkpoints/
