# Скопировать в .env и заполнить. Файл .env в git не попадает.
#
# Ключи в репозиторий не коммитятся: репозиторий на GitHub, а опубликованный
# ключ находят сканеры за минуты. Для CI то же значение кладётся в secrets
# репозитория, а не в файл.

# Nasdaq Data Link — исследовательские данные Sharadar (ТЗ 4.2).
# Бесплатный тариф отдаёт не все таблицы; проверить свой можно так:
#   python -m factorbot.data.build --check-access
NASDAQ_DATA_LINK_API_KEY=

# Alpaca — только проверка торгуемости и сверка цен (ТЗ 4.6).
# Отправки ордеров в проекте нет до прохождения проверок раздела 9 (ТЗ 2).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Снимает замок с hold-out периода (ТЗ 9.1). Держать пустым до самого конца.
FACTORBOT_UNLOCK_HOLDOUT=
